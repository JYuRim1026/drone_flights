{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": true,
  "services": {
    "frontend": {
      "root": "drone_filght/frontend"
    },
    "backend": {
      "root": "drone_filght/backend",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "backend" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/docs", "destination": { "service": "backend" } },
    { "source": "/openapi.json", "destination": { "service": "backend" } },
    { "source": "/pc", "destination": { "service": "frontend", "path": "/pc.html" } },
    { "source": "/mobile", "destination": { "service": "frontend", "path": "/mobile.html" } },
    { "source": "/camera", "destination": { "service": "frontend", "path": "/camera.html" } },
    { "source": "/", "destination": { "service": "frontend", "path": "/index.html" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
